# Required: OpenRouter API key. Free models only; a one-time $10 credit raises the daily free cap to about 1000 requests.
OPENROUTER_API_KEY=

# Optional: model lists per role, comma-separated, tried in order.
# SENTINEL_MODELS=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3.5-lightning:free,google/gemma-4-31b-it:free
# DECOY_A_MODELS=liquid/lfm-2.5-2.6b:free,apodex/apodex-1.1-mini:free
# DECOY_B_MODELS=google/gemma-4-26b-a4b-it:free,poolside/laguna-xs-2.1:free,nvidia/nemotron-3.5-lightning:free
# VISION_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,dots-studio/dots-3-note-preview:free
# AGENT_MODELS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-lightning:free,google/gemma-4-31b-it:free

# Optional: requests per minute across all models (the free tier allows about 20).
# LLM_RPM=18

# Optional: SQLite file location (the container stores it in a volume at /data).
# DB_PATH=data/tripwire.db
